{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/studio/cron",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/studio/cron?job=ideas",
      "schedule": "10 5 * * *"
    },
    {
      "path": "/api/studio/cron?job=draft",
      "schedule": "15 5 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "claude/*": false
    }
  }
}
