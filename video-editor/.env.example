# בלי אף מפתח העורך עובד במצב דמו מקומי.
# העתק לקובץ .env.local ומלא את מה שתרצה להפעיל.

# --- Supabase: התחברות, רשימת פרויקטים, שמירה בענן והעלאת קבצים ---
# Project Settings -> API ב-Supabase. ה-anon key ציבורי מטבעו; ה-RLS הוא שמגן על הנתונים
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- fal.ai: וריאציות ותמלול אמיתיים ---
# עם Supabase, וריאציות רצות כעבודות שרת (טבלת variant_jobs) וממשיכות גם אם הדף נסגר

# מפתח מ-https://fal.ai/dashboard/keys (נשאר בשרת, הדפדפן לא רואה אותו)
FAL_KEY=

# מודל video-to-video ליצירת וריאציות (מזהה ה-endpoint כפי שמופיע בעמוד המודל ב-fal)
FAL_VIDEO_MODEL=
# שדות קבועים נוספים לקלט של המודל, לפי התיעוד שלו (JSON). העורך שולח תמיד:
# video_url, prompt, strength, seed
FAL_VIDEO_EXTRA_INPUT={}

# תמלול (ברירת מחדל: fal-ai/whisper, עברית)
# FAL_TRANSCRIBE_MODEL=fal-ai/whisper
# FAL_TRANSCRIBE_LANGUAGE=he

# עם Supabase: ה-proxy ל-fal פתוח רק למשתמשים מחוברים.
# בלי Supabase: פתוח רק ב-npm run dev. אל תפעיל את השורה הבאה בפריסה ציבורית בלי Supabase
# ALLOW_PUBLIC_FAL_PROXY=true
