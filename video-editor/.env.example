# בלי אף מפתח העורך עובד במצב דמו מקומי.
# העתק לקובץ .env.local ומלא כדי להפעיל עיבוד אמיתי בענן דרך fal.ai

# מפתח מ-https://fal.ai/dashboard/keys (נשאר בשרת, הדפדפן לא רואה אותו)
FAL_KEY=

# מודל video-to-video ליצירת וריאציות (מזהה ה-endpoint כפי שמופיע בעמוד המודל ב-fal)
FAL_VIDEO_MODEL=
# שדות קבועים נוספים לקלט של המודל, לפי התיעוד שלו (JSON). העורך שולח תמיד:
# video_url, prompt, strength, seed
FAL_VIDEO_EXTRA_INPUT={}

# תמלול (ברירת מחדל: fal-ai/whisper, עברית)
# FAL_TRANSCRIBE_MODEL=fal-ai/whisper
# FAL_TRANSCRIBE_LANGUAGE=he

# ה-proxy ל-fal פתוח רק ב-npm run dev. אל תפעיל את זה בפריסה ציבורית לפני שיש Auth
# ALLOW_PUBLIC_FAL_PROXY=true
