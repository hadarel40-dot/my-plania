{
  "name": "StudioDraft",
  "type": "object",
  "properties": {
    "idea": { "type": "string", "description": "הרעיון או השם של הפוסט" },
    "account": { "type": "string", "description": "החשבון באינסטגרם" },
    "mode": { "type": "string", "enum": ["full", "short", "carousel"], "default": "full" },
    "content_type": { "type": "string", "enum": ["story", "value", "viral", "trust"] },
    "data": { "type": "object", "description": "כל הטיוטה: הקטעים והכרטיסים של הריל (edit), הגרסה, העיצוב, הקריינות, הצ'אט עם המעצב" }
  },
  "required": ["idea"],
  "rls": {
    "create": {},
    "read": { "created_by_id": "{{user.id}}" },
    "update": { "created_by_id": "{{user.id}}" },
    "delete": { "created_by_id": "{{user.id}}" }
  }
}
