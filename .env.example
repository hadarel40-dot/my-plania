# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Cloud API (https://developers.facebook.com → My Apps → WhatsApp → API Setup)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Any string you choose; paste the same string in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=choose-a-secret-string
# Meta app → Settings → Basic → App Secret (used to verify incoming webhooks)
WHATSAPP_APP_SECRET=

# Your personal number, international format without + (e.g. 972501234567).
# The agent only answers this number.
OWNER_PHONE=9725XXXXXXXX

TIMEZONE=Asia/Jerusalem
DB_PATH=agent.db
