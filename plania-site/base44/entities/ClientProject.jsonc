    },
    "source_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e9\u05d0\u05dc\u05d5\u05df \u05e9\u05de\u05de\u05e0\u05d5 \u05e0\u05d5\u05e6\u05e8 \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "start_date": {
      "type": "string",
