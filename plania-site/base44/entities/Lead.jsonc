{
  "name": "Lead",
  "properties": {
    "campaign": {
      "description": "\u05d0\u05d9\u05d6\u05d4 \u05e7\u05d9\u05e9\u05d5\u05e8 \u05de\u05e2\u05e7\u05d1 \u05d4\u05d1\u05d9\u05d0 \u05d0\u05ea \u05d4\u05dc\u05d9\u05d3 (utm_content)",
      "type": "string"
    },
    "deal_value": {
      "description": "\u05e9\u05d5\u05d5\u05d9 \u05d4\u05e2\u05e1\u05e7\u05d4 \u05d1\u05e9\"\u05d7",
      "type": "number"
    },
    "follow_up_date": {
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05de\u05e2\u05e7\u05d1",
      "format": "date",
      "type": "string"
    },
    "history": {
      "description": "\u05d9\u05d5\u05de\u05df \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd: \u05e1\u05d8\u05d8\u05d5\u05e1, \u05ea\u05d0\u05e8\u05d9\u05da \u05de\u05e2\u05e7\u05d1, \u05e9\u05d5\u05d5\u05d9 \u05d5\u05d4\u05e2\u05e8\u05d5\u05ea",
      "items": {
        "properties": {
          "at": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "message": {
      "description": "\u05d1\u05de\u05d4 \u05d0\u05e4\u05e9\u05e8 \u05dc\u05e2\u05d6\u05d5\u05e8",
      "type": "string"
    },
    "name": {
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0 \u05e9\u05dc \u05d4\u05e4\u05d5\u05e0\u05d4",
      "type": "string"
    },
    "notes": {
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e4\u05e0\u05d9\u05de\u05d9\u05d5\u05ea",
      "type": "string"
    },
    "phone": {
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8",
      "type": "string"
    },
    "service": {
      "description": "\u05d4\u05e9\u05d9\u05e8\u05d5\u05ea \u05e9\u05d0\u05dc\u05d9\u05d5 \u05e9\u05d9\u05d9\u05da \u05d4\u05dc\u05d9\u05d3",
      "enum": [
        "travel",
        "business",
        "plania"
      ],
      "type": "string"
    },
    "source": {
      "description": "\u05de\u05d0\u05d9\u05e4\u05d4 \u05d4\u05d2\u05d9\u05e2 \u05d4\u05dc\u05d9\u05d3: instagram, facebook, whatsapp, google \u05d5\u05db\u05d5'",
      "type": "string"
    },
    "status": {
      "default": "\u05dc\u05d9\u05d3 \u05d7\u05d3\u05e9",
      "description": "\u05de\u05e6\u05d1 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05dc\u05d9\u05d3",
      "enum": [
        "\u05dc\u05d9\u05d3 \u05d7\u05d3\u05e9",
        "\u05d1\u05e9\u05d9\u05d7\u05d4",
        "\u05d4\u05e6\u05e2\u05ea \u05de\u05d7\u05d9\u05e8 \u05e0\u05e9\u05dc\u05d7\u05d4",
        "\u05e0\u05e1\u05d2\u05e8",
        "\u05dc\u05e7\u05d5\u05d7 \u05e4\u05e2\u05d9\u05dc",
        "\u05dc\u05d0 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9"
      ],
      "type": "string"
    }
  },
  "required": [
    "name",
    "phone",
    "service"
  ],
  "type": "object",
