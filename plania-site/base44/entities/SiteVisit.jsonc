{
  "name": "SiteVisit",
  "properties": {
    "campaign": {
      "description": "\u05d0\u05d9\u05d6\u05d4 \u05e7\u05d9\u05e9\u05d5\u05e8 \u05de\u05e2\u05e7\u05d1 \u05d4\u05d1\u05d9\u05d0 \u05d0\u05ea \u05d4\u05de\u05d1\u05e7\u05e8 (utm_content)",
      "type": "string"
    },
    "device": {
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05db\u05e9\u05d9\u05e8",
      "enum": [
        "mobile",
        "desktop"
      ],
      "type": "string"
    },
    "is_entry": {
      "description": "\u05d4\u05d0\u05dd \u05d6\u05d4 \u05d4\u05e2\u05de\u05d5\u05d3 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05d1\u05d9\u05e7\u05d5\u05e8",
      "type": "boolean"
    },
    "path": {
      "description": "\u05d4\u05e0\u05ea\u05d9\u05d1 \u05e9\u05e0\u05e6\u05e4\u05d4 \u05d1\u05d0\u05ea\u05e8",
      "type": "string"
    },
    "referrer": {
      "description": "\u05de\u05d0\u05d9\u05d6\u05d4 \u05d0\u05ea\u05e8 \u05d4\u05d2\u05d9\u05e2 \u05d4\u05de\u05d1\u05e7\u05e8",
      "type": "string"
    },
    "session_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05d9\u05e7\u05d5\u05e8 (\u05e9\u05d9\u05d7\u05d4) \u05dc\u05e7\u05d9\u05d1\u05d5\u05e5 \u05e6\u05e4\u05d9\u05d5\u05ea \u05e9\u05dc \u05d0\u05d5\u05ea\u05d5 \u05de\u05d1\u05e7\u05e8",
      "type": "string"
    },
    "source": {
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05d4\u05d2\u05e2\u05d4: instagram, facebook, whatsapp, google \u05d5\u05db\u05d5'",
      "type": "string"
    }
  },
  "required": [
    "path",
    "session_id"
  ],
  "type": "object",
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}